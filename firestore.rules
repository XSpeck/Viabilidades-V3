rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nivel == 1;
    }

    // Usuários — cada um lê o próprio doc, admin lista e gerencia todos
    match /users/{uid} {
      allow get: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Viabilizações
    match /viabilizacoes/{id} {
      allow read, create, update: if isAuth();
      allow delete: if isAuth();
    }

    // Prédios atendidos
    match /predios_atendidos/{id} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Prédios sem viabilidade
    match /predios_sem_viabilidade/{id} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // CTOs (documento único agrupado)
    match /ctos_data/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // CTOs Gmarx (coleção separada)
    match /ctos_gmarx/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Redes distribuidoras
    match /redes_distribuidoras/{id} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Demandas de rede
    match /demandas_rede/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Rotas ópticas (tela Rota Óptica, só ADM)
    match /rotas_opticas/{id} {
      allow read, write: if isAdmin();
    }

    // Diagrama interno das caixas (splitter e portas), editado na árvore PON — só ADM
    match /caixas_rede/{id} {
      allow read, write: if isAdmin();
    }

    // Cabos: capacidade e anotações por fibra, editados na árvore PON — só ADM
    match /cabos_rede/{id} {
      allow read, write: if isAdmin();
    }

    // Cadastro de equipamentos (tipos de cabo, splitter, DIO, OLT) — só ADM
    match /catalogo_rede/{id} {
      allow read, write: if isAdmin();
    }

    // Prédios verticais (blocos, andares e CDOIs), editados na árvore PON — só ADM
    match /predios_rede/{id} {
      allow read, write: if isAdmin();
    }

    // Bairros de rede
    match /bairros_rede/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Fila de notificações do bot — escrita pelo app, leitura só via Admin SDK
    match /bot_notificacoes/{id} {
      allow create: if isAuth();
      allow read, update, delete: if false;
    }

    // Financeiro — tipos de serviço (tabela de preços)
    match /tipos_servico_financeiro/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Financeiro — serviços prestados pelos técnicos
    match /servicos_financeiro/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // Financeiro — fechamentos de pagamento mensal
    match /fechamentos_pagamento/{id} {
      allow read, create: if isAuth();
    }
  }
}
